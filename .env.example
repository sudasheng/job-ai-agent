# ============================================================
# Job AI Agent - 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ============================================================

# ---------- 应用配置 ----------
APP_NAME=JobAIAgent
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret-key
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------- MySQL 数据库 ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=job_ai_agent
MYSQL_POOL_SIZE=20
MYSQL_MAX_OVERFLOW=40
MYSQL_ECHO=false

# ---------- ChromaDB 向量数据库 ----------
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=job_knowledge

# ---------- DeepSeek LLM ----------
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=4096

# ---------- 千问 Embedding ----------
QWEN_API_KEY=your-qwen-api-key-here
QWEN_EMBEDDING_MODEL=text-embedding-v3
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- Playwright 浏览器 ----------
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_COOKIE_DIR=./data/cookies
PLAYWRIGHT_TIMEOUT=30000

# ---------- JWT 认证 ----------
JWT_SECRET_KEY=change-me-to-a-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_FILE=./data/logs/app.log

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]